cabal-version:      2.4
name:               platformer
version:            1.0.0.0
synopsis:           3B platform oyunu (Haskell + gloss)
description:        Gokyuzu Adalari - Haskell ile yazilmis 3B platform oyunu.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Eren
maintainer:         HiX5eT@users.noreply.github.com
homepage:           https://github.com/HiX5eT/H-Platformer
bug-reports:        https://github.com/HiX5eT/H-Platformer/issues
category:           Game
build-type:         Simple
extra-source-files: README.md

executable platformer
  main-is:            Main.hs
  hs-source-dirs:     app, src
  other-modules:      Game.Math
                    , Game.Types
                    , Game.Level
                    , Game.Physics
                    , Game.Render
                    , Game.Update
  build-depends:      base >= 4.14 && < 5
                    , gloss >= 1.13 && < 1.14
                    , containers >= 0.6
  default-language:   Haskell2010
  ghc-options:        -O2 -Wall -funbox-strict-fields
